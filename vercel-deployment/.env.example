# "production" | "staging" | "development". Anything other than "production"
# shows a small fixed "Staging" banner on every page so it's never confused
# with the live app. Unset defaults to "development" (banner shown) -- set
# this explicitly to "production" only on the real production deployment.
APP_ENV=development

# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# There is no payment processor (no Stripe or equivalent) -- billing is a
# manual, direct arrangement. Shown in the footer and used as the mailto
# target for every plan change (upgrade/downgrade/cancel) and billing
# question -- set this to a real inbox before launch.
NEXT_PUBLIC_CONTACT_EMAIL=sales@example.com

# Encryption Key for API Keys (32 bytes base64)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# Provider API Keys (optional - for server-side ensemble; set at least one)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
GROQ_API_KEY=gsk_...

# Python Ensemble Configuration
BOT_COUNT=4
PRIVACY_REDACTION=1
SAVE_HISTORY=1

# Internal function auth -- shared secret the Next.js API routes send to the
# query-ensemble/training-job Vercel functions (never exposed to the browser)
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# CORS allow-list for the query-ensemble function (your deployed app origin)
APP_ORIGIN=https://your-app.vercel.app

# Optional: backstop request cap for the query-ensemble function (per minute)
QUERY_RATE_LIMIT_PER_MINUTE=1000

# Optional: global daily cap across ALL anonymous (no account) queries
# combined, on top of the existing 3/min per-IP limit. Default 200.
ANON_DAILY_QUERY_CAP=200

# Optional: global daily cap (USD) on ESTIMATED provider cost across every
# account combined (see src/lib/providerCost.ts / spendCap.ts). Unset or <= 0
# disables the cap entirely. Once reached, /api/query stops calling paid
# providers and returns a "temporarily limited" error; a loud warning is
# logged once spend crosses 80% of the cap.
# DAILY_PROVIDER_SPEND_CAP_USD=50

# Optional: shared, cross-instance rate limiting (Upstash Redis REST API).
# Used by both the Next.js routes and the query-ensemble function; set both
# or neither. Without these, rate limiting falls back to an in-memory
# per-process counter (fine for a single instance, not shared across
# serverless instances). Get these from an Upstash Redis database's REST API
# tab -- no separate Vercel secret setup needed, add them directly as project
# env vars.
# UPSTASH_REDIS_REST_URL=https://your-db.upstash.io
# UPSTASH_REDIS_REST_TOKEN=...

# Lifecycle transactional email (welcome, low credits, plan expiring -- see
# src/lib/email.ts). Outside production, a missing RESEND_API_KEY logs the
# email instead of sending it, so these are optional for local dev/staging.
# RESEND_API_KEY=re_...
# EMAIL_FROM=MultiLLM <onboarding@yourdomain.com>
# Linked from the welcome email -- a real URL to your onboarding guide/docs.
# ONBOARDING_GUIDE_URL=https://your-app.vercel.app/docs/getting-started

# Shared secret the daily plan-expiring cron (vercel.json) must present as
# `Authorization: Bearer <value>` -- set this as a Vercel project env var so
# Vercel's own cron invocations include it automatically. Required for that
# route to do anything; a long random value, never a guessable one.
# CRON_SECRET=change-me-to-a-long-random-string

# PYTHON_ENSEMBLE_INTERNAL_URL is NOT something you set here -- Vercel injects
# it automatically at runtime from the "backend" service binding declared in
# vercel.json (the query-ensemble Python function is deployed as a private
# Vercel Service, not a public URL). Do not add it as a project env var; doing
# so would override the real binding value.
#
# training-job has no equivalent: it's excluded from deployment entirely, see
# vercel-deployment/training-job-disabled/DISABLED.md.