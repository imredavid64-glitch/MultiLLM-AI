# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Encryption Key for API Keys (32 bytes base64)
ENCRYPTION_KEY=your-32-byte-base64-encoded-key

# Provider API Keys (optional - for server-side ensemble; set at least one)
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
MISTRAL_API_KEY=...
GROQ_API_KEY=gsk_...

# Python Ensemble Configuration
BOT_COUNT=4
PRIVACY_REDACTION=1
SAVE_HISTORY=1

# Internal function auth -- shared secret the Next.js API routes send to the
# query-ensemble/training-job Vercel functions (never exposed to the browser)
INTERNAL_API_SECRET=change-me-to-a-long-random-string

# CORS allow-list for the query-ensemble function (your deployed app origin)
APP_ORIGIN=https://your-app.vercel.app

# Optional: backstop request cap for the query-ensemble function (per minute)
QUERY_RATE_LIMIT_PER_MINUTE=1000

# URLs for the two Vercel Python functions (usually your deployed domain)
PYTHON_ENSEMBLE_URL=https://your-app.vercel.app/functions/query-ensemble
PYTHON_TRAINING_URL=https://your-app.vercel.app/functions/training-job